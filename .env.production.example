# ==============================================================================
# Real Estate Monorepo - Production Environment Variables Template
# Copy this file to '.env' on your AWS EC2 instance before running 'docker compose up -d'
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL + PostGIS)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=real_estate

# Connection URL used by NestJS & Prisma inside Docker container
# 'db' corresponds to the postgres container name on internal network 'real-estate-net'
DATABASE_URL="postgresql://postgres:your_secure_db_password_here@db:5432/real_estate?schema=public&sslmode=prefer"

# ------------------------------------------------------------------------------
# 2. NestJS Backend Server Configuration
# ------------------------------------------------------------------------------
PORT=8080
CLIENT_URL="http://your-ec2-public-ip-or-domain:3000"
JWT_SECRET=your_long_random_jwt_secret_key_here

# AWS Credentials & Services
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=your_s3_bucket_name
AWS_SES_SENDER_EMAIL=your_email@example.com
AWS_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
AWS_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 3. Next.js Frontend Client Configuration (Build-time variables)
# ------------------------------------------------------------------------------
# Point this to your EC2 Public IP or Domain (e.g., http://54.210.xx.xx:8080 or https://api.yourdomain.com)
NEXT_PUBLIC_API_BASE_URL=http://your-ec2-public-ip-or-domain:8080

NEXT_PUBLIC_AWS_REGION=us-east-1
NEXT_PUBLIC_AWS_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
NEXT_PUBLIC_AWS_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_AWS_COGNITO_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NEXT_PUBLIC_AWS_LOCATION_MAP_NAME=RealEstateMap
NEXT_PUBLIC_AWS_LOCATION_API_KEY=your_aws_location_api_key
